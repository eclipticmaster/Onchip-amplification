# Native INTERCONNECT SOA/CML template workflow.
# Supply SOA_TEMPLATE.icp with the named components/properties from YAML.
# Verify bindings with inspect-interconnect first; model names vary by version.
# The template must contain the active SOA physics/current connection.
# No scalar/Python gain is injected into this native model.
load("SOA_TEMPLATE.icp");
switchtodesign;
setnamed("pump_laser","frequency",193414489032258);
setnamed("pump_laser","power",0.001);
setnamed("bias_current","amplitude",0.25);
save("inp_pump.icp");
run;
output_spectrum=getresult("output_osa","spectrum");
matlabsave("output_spectrum.mat",output_spectrum);
save("inp_pump.icp");
?"INTERCONNECT finished. Verify active SOA calibration and analyzer reference planes.";
