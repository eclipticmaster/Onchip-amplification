# Open in Ansys Lumerical FDTD; run in this export folder.
# PASSIVE InP-platform taper coupon, propagation along x, vertical z.
# The current/gain rate equations and microcomb are NOT simulated by FDTD here.
# This coupon length is lumerical.fdtd.taper_length_um, not the full SOA length.
switchtolayout;
deleteall;
addrect;
set("name","InP_cladding");
set("x",0);
set("x span",2.6e-05);
set("y",0);
set("y span",4.4e-06);
set("z",0);
set("z span",3.3e-06);
set("material","<Object defined dielectric>");
set("index",3.17);
set("override mesh order from material database",1);
set("mesh order",3);
addrect;
set("name","input_ridge");
set("x",-1.15e-05);
set("x span",3e-06);
set("y",0);
set("y span",8e-07);
set("z",0);
set("z span",4e-07);
set("material","<Object defined dielectric>");
set("index",3.4);
set("override mesh order from material database",1);
set("mesh order",1);
addrect;
set("name","output_ridge");
set("x",1.15e-05);
set("x span",3e-06);
set("y",0);
set("y span",2e-06);
set("z",0);
set("z span",4e-07);
set("material","<Object defined dielectric>");
set("index",3.4);
set("override mesh order from material database",1);
set("mesh order",1);
addpoly;
set("name","taper"); set("vertices",[-9.999999999999999e-06,-4e-07;9.999999999999999e-06,-1e-06;9.999999999999999e-06,1e-06;-9.999999999999999e-06,4e-07]);
set("z",0); set("z span",4e-07);
set("material","<Object defined dielectric>");
set("index",3.4);
set("override mesh order from material database",1); set("mesh order",1);
addfdtd;
# The built-in FDTD solver name is read-only.
set("dimension","3D");
set("x",0); set("x span",2.4e-05);
set("y",0); set("y span",4e-06);
set("z",0); set("z span",3e-06);
set("mesh accuracy",2);
set("simulation time",5.000000000000001e-12);
set("x min bc","PML"); set("x max bc","PML");
set("y min bc","PML"); set("y max bc","PML");
set("z min bc","PML"); set("z max bc","PML");
addmesh; set("name","taper_mesh");
set("x",0); set("x span",2.4e-05);
set("y",0); set("y span",3e-06);
set("z",0); set("z span",1.4e-06);
set("override x mesh",1); set("override y mesh",1); set("override z mesh",1);
set("dx",5e-08); set("dy",5e-08); set("dz",5e-08);
addmode;
set("name","pump"); set("injection axis","x-axis"); set("direction","Forward");
set("x",-1.1e-05);
set("y",0); set("y span",3.2e-06);
set("z",0); set("z span",2.4e-06);
set("mode selection","fundamental TE mode");
set("wavelength start",1.5e-06);
set("wavelength stop",1.6e-06);
setglobalmonitor("frequency points",21);
addpower; set("name","T"); set("monitor type","2D X-normal");
set("x",1.1e-05);
set("y",0); set("y span",3.6e-06); set("z",0); set("z span",2.7e-06);
addpower; set("name","R"); set("monitor type","2D X-normal");
set("x",-1.15e-05);
set("y",0); set("y span",3.6e-06); set("z",0); set("z span",2.7e-06);
save("inp_taper.fsp");
run;
f=getdata("T","f");
T=transmission("T"); R=-transmission("R");
matlabsave("taper_transmission.mat",f,T,R);
save("inp_taper.fsp");
?"FDTD finished. These are total monitor fluxes, not a guided-mode S matrix.";
